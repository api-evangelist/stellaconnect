            "headers": [
              {
                "name": "Authorization",
                "value": "[insert your token here]"
              },
              {
                "name": "x-api-key",
                "value": "[insert your API key here]"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create Employee"
        },
        {
          "info": {
            "name": "Deactivate Employee",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{subdomain}.api.stellaconnect.net/v2/employees/:id/deactivate",
            "headers": [
              {
                "name": "Authorization",
                "value": "[insert your token here]"
              },
              {
                "name": "x-api-key",
                "value": "[insert your API key here]"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Email or custom_employee_id of the employee"
              }
            ]
          },
          "docs": "Deactivate Employee"
        },
        {
          "info": {
            "name": "Invite Employee",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.api.stellaconnect.net/v2/employees/invite",
            "headers": [
              {
                "name": "Authorization",
                "value": "[insert your token here]"
              },
              {
                "name": "x-api-key",
                "value": "[insert your API key here]"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Invite Employee"
        }
      ]
    }
  ],
  "bundled": true
}