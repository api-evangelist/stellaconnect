{
  "opencollection": "1.0.0",
  "info": {
    "name": "Agent Connect Coaching Requests API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Requests",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a standard feedback request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.api.stellaconnect.net/v1/requests",
            "headers": [
              {
                "name": "x-api-key",
                "value": "[insert your API key here]"
              },
              {
                "name": "Accept",
                "value": "application/json"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a standard feedback request"
        }
      ]
    }
  ],
  "bundled": true
}